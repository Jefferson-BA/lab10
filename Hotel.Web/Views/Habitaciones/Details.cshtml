@model Hotel.Web.Models.Habitacion
@{
    ViewData["Title"] = "Detalle de Habitacion";
}

<div class="page-header">
    <span class="page-label">Habitaciones / Detalle</span>
    <h1>Habitacion @Model.Numero</h1>
</div>

<div style="max-width:540px">
    <div class="panel panel--accent">
        <div class="panel__head">
            <span class="panel__title">Informacion de la Habitacion</span>
            <span class="badge-lux @(Model.Activo ? "badge-lux--green" : "badge-lux--red")">
                @(Model.Activo ? "Activa" : "Inactiva")
            </span>
        </div>
        <div class="panel__body">
            <table class="lux-table" style="border:none">
                <tbody>
                    <tr>
                        <td class="cell-muted" style="width:45%">Numero</td>
                        <td style="font-family:var(--ff-display);font-size:1.1rem;color:var(--clr-white)">
                            @Model.Numero
                        </td>
                    </tr>
                    <tr>
                        <td class="cell-muted">Piso</td>
                        <td>@Model.Piso</td>
                    </tr>
                    <tr>
                        <td class="cell-muted">Tipo</td>
                        <td><span class="badge-lux badge-lux--gold">@Model.IdTipoHabitacionNavigation.Nombre</span></td>
                    </tr>
                    <tr>
                        <td class="cell-muted">Capacidad</td>
                        <td>@Model.IdTipoHabitacionNavigation.Capacidad persona(s)</td>
                    </tr>
                    <tr>
                        <td class="cell-muted">Precio / Noche</td>
                        <td class="text-gold mono" style="font-size:1.05rem">
                            S/.&nbsp;@Model.IdTipoHabitacionNavigation.PrecioNoche.ToString("N2")
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="panel__foot d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.IdHabitacion" class="btn-lux-outline btn-sm-lux">Editar</a>
            <a asp-action="Index" class="btn-lux-ghost btn-sm-lux">Volver al listado</a>
        </div>
    </div>
</div>
