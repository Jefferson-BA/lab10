@model Hotel.Web.Models.Habitacion
@{
    ViewData["Title"] = "Nueva Habitacion";
}

<div class="page-header">
    <span class="page-label">Habitaciones / Nuevo Registro</span>
    <h1>Nueva Habitacion</h1>
    <p>Complete los campos para registrar una nueva habitacion en el sistema</p>
</div>

<div style="max-width:520px">
    <div class="panel panel--accent">
        <div class="panel__head">
            <span class="panel__title">Datos de la Habitacion</span>
        </div>
        <div class="panel__body">
            <form asp-action="Create" method="post" id="formCrearHabitacion" novalidate>
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label asp-for="Numero" class="form-label-lux">Numero de Habitacion</label>
                    <input asp-for="Numero" class="form-control-lux" id="Numero"
                           placeholder="Ej. 101" maxlength="10" autocomplete="off" />
                    <span asp-validation-for="Numero" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Piso" class="form-label-lux">Piso</label>
                    <input asp-for="Piso" type="number" class="form-control-lux" id="Piso"
                           min="1" placeholder="1" />
                    <span asp-validation-for="Piso" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="IdTipoHabitacion" class="form-label-lux">Tipo de Habitacion</label>
                    <select asp-for="IdTipoHabitacion" asp-items="ViewBag.IdTipoHabitacion"
                            class="form-select-lux" id="IdTipoHabitacion">
                        <option value="">Seleccione un tipo</option>
                    </select>
                    <span asp-validation-for="IdTipoHabitacion" class="field-error"></span>
                </div>

                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn-lux" id="btnGuardarHabitacion">Guardar Registro</button>
                    <a asp-action="Index" class="btn-lux-ghost">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}
