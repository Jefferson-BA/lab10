@model Hotel.Web.Models.Habitacion
@{
    ViewData["Title"] = "Editar Habitacion";
}

<div class="page-header">
    <span class="page-label">Habitaciones / Edicion</span>
    <h1>Habitacion @Model.Numero</h1>
    <p>Modifique los campos necesarios y confirme los cambios</p>
</div>

<div style="max-width:520px">
    <div class="panel panel--accent">
        <div class="panel__head">
            <span class="panel__title">Editar Datos</span>
        </div>
        <div class="panel__body">
            <form asp-action="Edit" method="post" id="formEditarHabitacion" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="IdHabitacion" />
                <input type="hidden" asp-for="Activo" />

                <div class="form-group">
                    <label asp-for="Numero" class="form-label-lux">Numero de Habitacion</label>
                    <input asp-for="Numero" class="form-control-lux" id="NumeroEdit" maxlength="10" />
                    <span asp-validation-for="Numero" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Piso" class="form-label-lux">Piso</label>
                    <input asp-for="Piso" type="number" class="form-control-lux" id="PisoEdit" min="1" />
                    <span asp-validation-for="Piso" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="IdTipoHabitacion" class="form-label-lux">Tipo de Habitacion</label>
                    <select asp-for="IdTipoHabitacion" asp-items="ViewBag.IdTipoHabitacion"
                            class="form-select-lux" id="IdTipoHabitacionEdit">
                        <option value="">Seleccione un tipo</option>
                    </select>
                    <span asp-validation-for="IdTipoHabitacion" class="field-error"></span>
                </div>

                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn-lux" id="btnActualizarHabitacion">Actualizar Registro</button>
                    <a asp-action="Index" class="btn-lux-ghost">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}
