@model List<Hotel.Web.Models.Habitacion>
@{
    ViewData["Title"] = "Habitaciones";
}

<div class="page-header">
    <span class="page-label">Inventario</span>
    <h1>Habitaciones</h1>
    <p>Registro de habitaciones activas del establecimiento</p>
</div>

<!-- Filter bar -->
<div class="filter-bar" role="search">
    <form method="get" id="formFiltroTipo" class="d-flex gap-2 align-center flex-wrap" style="flex:1">
        <div style="flex:1;min-width:200px">
            <label class="form-label-lux" for="idTipo">Filtrar por tipo</label>
            @Html.DropDownList("idTipo", ViewBag.Tipos as SelectList,
                "Todos los tipos", new { @class = "form-select-lux", id = "idTipo" })
        </div>
        <div class="d-flex gap-1 align-center" style="padding-top:1.3rem">
            <button type="submit" class="btn-lux btn-sm-lux" id="btnFiltrar">Filtrar</button>
            <a asp-action="Index" class="btn-lux-ghost btn-sm-lux">Limpiar</a>
        </div>
    </form>
    <div style="padding-top:1.3rem">
        <a asp-action="Create" class="btn-lux" id="btnNuevaHabitacion">Nueva Habitacion</a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert-lux alert-lux--info" role="status">
        No se encontraron habitaciones activas@(ViewBag.FiltroTipo != null ? " para el tipo seleccionado" : "").
    </div>
}
else
{
    <div class="lux-table-wrap panel">
        <table class="lux-table" aria-label="Listado de habitaciones">
            <thead>
                <tr>
                    <th scope="col">Num.</th>
                    <th scope="col">Piso</th>
                    <th scope="col">Tipo</th>
                    <th scope="col">Capacidad</th>
                    <th scope="col" style="text-align:right">Precio / Noche</th>
                    <th scope="col" style="text-align:center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var h in Model)
                {
                    <tr>
                        <td>
                            <span style="font-family:var(--ff-display);font-size:1.05rem;color:var(--clr-white)">
                                @h.Numero
                            </span>
                        </td>
                        <td class="cell-muted">Piso @h.Piso</td>
                        <td>
                            <span class="badge-lux badge-lux--gold">@h.IdTipoHabitacionNavigation.Nombre</span>
                        </td>
                        <td class="cell-muted">@h.IdTipoHabitacionNavigation.Capacidad pax</td>
                        <td class="cell-right mono">
                            S/.&nbsp;@h.IdTipoHabitacionNavigation.PrecioNoche.ToString("N2")
                        </td>
                        <td class="cell-center">
                            <div class="d-flex gap-1 justify-center" style="justify-content:center">
                                <a asp-action="Details" asp-route-id="@h.IdHabitacion"
                                   class="btn-lux-ghost btn-sm-lux" title="Ver detalle">Detalle</a>
                                <a asp-action="Edit" asp-route-id="@h.IdHabitacion"
                                   class="btn-lux-outline btn-sm-lux" title="Editar">Editar</a>
                                <a asp-action="Delete" asp-route-id="@h.IdHabitacion"
                                   class="btn-lux-danger btn-sm-lux" title="Dar de baja">Baja</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="panel__foot">@Model.Count habitacion(es) activa(s)</div>
    </div>
}
