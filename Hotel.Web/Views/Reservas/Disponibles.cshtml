@model List<Hotel.Web.Models.Habitacion>?
@{
    ViewData["Title"] = "Consulta de Disponibilidad";
    DateOnly? ingreso = ViewBag.Ingreso;
    DateOnly? salida  = ViewBag.Salida;
    int?      noches  = ViewBag.Noches;
    DateOnly  hoy     = ViewBag.Hoy;
}

<div class="page-header">
    <span class="page-label">Disponibilidad</span>
    <h1>Consulta de Disponibilidad</h1>
    <p>Seleccione el rango de fechas para visualizar las habitaciones disponibles</p>
</div>

<!-- Filter panel -->
<div class="panel mb-3">
    <div class="panel__head">
        <span class="panel__title">Rango de Fechas</span>
    </div>
    <div class="panel__body">
        <form method="get" id="formDisponibilidad">
            <div class="filter-bar" style="border:none;padding:0;margin-bottom:0">
                <div style="flex:1;min-width:180px">
                    <label class="form-label-lux" for="ingreso">Fecha de Ingreso</label>
                    <input type="date" name="ingreso" id="ingreso" class="form-control-lux"
                           value="@ingreso?.ToString("yyyy-MM-dd")"
                           min="@hoy.ToString("yyyy-MM-dd")" required />
                </div>
                <div style="flex:1;min-width:180px">
                    <label class="form-label-lux" for="salida">Fecha de Salida</label>
                    <input type="date" name="salida" id="salida" class="form-control-lux"
                           value="@salida?.ToString("yyyy-MM-dd")"
                           min="@hoy.AddDays(1).ToString("yyyy-MM-dd")" required />
                </div>
                <div style="padding-top:1.3rem">
                    <button type="submit" class="btn-lux" id="btnBuscarDisponibles">
                        Buscar Disponibilidad
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@if (Model is not null)
{
    @if (!Model.Any())
    {
        <div class="alert-lux alert-lux--warning" role="status">
            No hay habitaciones disponibles para el periodo seleccionado
            (@ingreso?.ToString("dd/MM/yyyy") &mdash; @salida?.ToString("dd/MM/yyyy")).
        </div>
    }
    else
    {
        <div class="alert-lux alert-lux--info mb-3" role="status">
            <strong>@Model.Count</strong> habitacion(es) disponible(s) para
            <strong>@noches</strong> noche(s) &middot;
            @ingreso?.ToString("dd/MM/yyyy") al @salida?.ToString("dd/MM/yyyy")
        </div>

        <div class="avail-grid" role="list" aria-label="Habitaciones disponibles">
            @foreach (var h in Model)
            {
                var precioNoche = h.IdTipoHabitacionNavigation.PrecioNoche;
                var totalEst    = (noches ?? 0) * precioNoche;

                <article class="avail-card" role="listitem">
                    <div class="d-flex justify-between align-center">
                        <span class="avail-card__num">Hab.&nbsp;@h.Numero</span>
                        <span class="badge-lux badge-lux--gray">Piso @h.Piso</span>
                    </div>

                    <span class="avail-card__type">@h.IdTipoHabitacionNavigation.Nombre</span>

                    <div class="avail-card__meta">
                        <span>@h.IdTipoHabitacionNavigation.Capacidad persona(s)</span>
                        <span class="avail-card__price">S/.&nbsp;@precioNoche.ToString("N2") / noche</span>
                    </div>

                    <div class="avail-card__divider"></div>

                    <div class="avail-card__total">
                        S/.&nbsp;@totalEst.ToString("N2")
                        <span style="font-family:var(--ff-body);font-size:.72rem;color:var(--clr-text-3);display:block;margin-top:.1rem">
                            @noches noche(s) &middot; total estimado
                        </span>
                    </div>

                    <a asp-controller="Reservas" asp-action="Create"
                       asp-route-idHabitacion="@h.IdHabitacion"
                       asp-route-ingreso="@ingreso?.ToString("yyyy-MM-dd")"
                       asp-route-salida="@salida?.ToString("yyyy-MM-dd")"
                       class="btn-lux btn-sm-lux w-100 mt-2"
                       id="btnReservar-@h.IdHabitacion"
                       style="justify-content:center">
                        Reservar
                    </a>
                </article>
            }
        </div>
    }
}
else
{
    <div class="panel" style="padding:3rem;text-align:center;color:var(--clr-text-3)">
        <p style="font-family:var(--ff-display);font-size:1.2rem;color:var(--clr-text-2);margin-bottom:.5rem">
            Seleccione las fechas de ingreso y salida para iniciar la consulta
        </p>
        <p style="font-size:.8rem;letter-spacing:.06em">
            El sistema verificara disponibilidad en tiempo real excluyendo reservas activas
        </p>
    </div>
}
