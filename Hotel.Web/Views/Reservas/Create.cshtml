@model Hotel.Web.Models.Reserva
@{
    ViewData["Title"] = "Nueva Reserva";
    var huespedes    = ViewBag.Huespedes  as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new();
    var habitaciones = ViewBag.Habitaciones as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new();
    var hoy = DateOnly.FromDateTime(DateTime.Today);
}

<div class="page-header">
    <span class="page-label">Reservas / Nuevo Registro</span>
    <h1>Nueva Reserva</h1>
    <p>Complete los datos para crear una reserva en estado Pendiente</p>
</div>

<div style="max-width:600px">
    <div class="panel panel--accent">
        <div class="panel__head">
            <span class="panel__title">Datos de la Reserva</span>
        </div>
        <div class="panel__body">
            <form asp-action="Create" method="post" id="formCrearReserva" novalidate>
                @Html.AntiForgeryToken()

                <!-- Huesped -->
                <div class="form-group">
                    <label class="form-label-lux" for="IdHuesped">Huesped</label>
                    <select name="IdHuesped" id="IdHuesped" class="form-select-lux">
                        <option value="">Seleccione un huesped</option>
                        @foreach (var item in huespedes)
                        {
                            if (item.Selected)
                            {
                                <option value="@item.Value" selected="selected">@item.Text</option>
                            }
                            else
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="IdHuesped" class="field-error"></span>
                </div>

                <!-- Habitacion -->
                <div class="form-group">
                    <label class="form-label-lux" for="IdHabitacion">Habitacion</label>
                    <select name="IdHabitacion" id="IdHabitacion" class="form-select-lux">
                        <option value="">Seleccione una habitacion</option>
                        @foreach (var item in habitaciones)
                        {
                            if (item.Selected)
                            {
                                <option value="@item.Value" selected="selected">@item.Text</option>
                            }
                            else
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="IdHabitacion" class="field-error"></span>
                </div>

                <!-- Fechas -->
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem">
                    <div class="form-group" style="margin-bottom:0">
                        <label asp-for="FechaIngreso" class="form-label-lux">Fecha de Ingreso</label>
                        <input asp-for="FechaIngreso" type="date" class="form-control-lux"
                               id="FechaIngreso"
                               value="@Model.FechaIngreso.ToString("yyyy-MM-dd")"
                               min="@hoy.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="FechaIngreso" class="field-error"></span>
                    </div>
                    <div class="form-group" style="margin-bottom:0">
                        <label asp-for="FechaSalida" class="form-label-lux">Fecha de Salida</label>
                        <input asp-for="FechaSalida" type="date" class="form-control-lux"
                               id="FechaSalida"
                               value="@Model.FechaSalida.ToString("yyyy-MM-dd")"
                               min="@hoy.AddDays(1).ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="FechaSalida" class="field-error"></span>
                    </div>
                </div>

                <!-- Observaciones -->
                <div class="form-group mt-3">
                    <label asp-for="Observaciones" class="form-label-lux">Observaciones</label>
                    <textarea asp-for="Observaciones" class="form-control-lux" id="Observaciones"
                              rows="3" maxlength="200"
                              placeholder="Notas adicionales sobre la reserva (opcional)"></textarea>
                    <span asp-validation-for="Observaciones" class="field-error"></span>
                </div>

                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn-lux" id="btnGuardarReserva">Confirmar Reserva</button>
                    <a asp-action="Disponibles" class="btn-lux-ghost">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script>
        var fi = document.getElementById('FechaIngreso');
        var fs = document.getElementById('FechaSalida');
        if (fi && fs) {
            fi.addEventListener('change', function () {
                if (this.value >= fs.value) {
                    var d = new Date(this.value);
                    d.setDate(d.getDate() + 1);
                    fs.value = d.toISOString().slice(0, 10);
                }
                fs.min = this.value;
            });
        }
    </script>
}
