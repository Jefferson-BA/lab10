<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Hotel Aurora — Sistema de Gestión Hotelera de Lujo." />
    <title>@ViewData["Title"] — Hotel Aurora</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <!-- ── Navigation ─────────────────────────────────────── -->
    <header>
        <nav class="hotel-nav" id="mainNav" role="navigation" aria-label="Navegación principal">
            <div class="container">

                <a class="nav-brand" asp-controller="Home" asp-action="Index" aria-label="Hotel Aurora — Inicio">
                    <span class="nav-brand__name">Hotel Aurora</span>
                    <span class="nav-brand__sub">Luxury &amp; Boutique</span>
                </a>

                <button class="nav-toggle" id="navToggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="navLinks">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>

                <ul class="nav-links" id="navLinks" role="list">
                    <li>
                        <a asp-controller="Habitaciones" asp-action="Index"
                           class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Habitaciones" ? "active" : "")">
                            Habitaciones
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Reservas" asp-action="Disponibles"
                           class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Reservas" && ViewContext.RouteData.Values["action"]?.ToString() == "Disponibles" ? "active" : "")">
                            Disponibilidad
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Reservas" asp-action="Index"
                           class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Reservas" && ViewContext.RouteData.Values["action"]?.ToString() != "Disponibles" && ViewContext.RouteData.Values["action"]?.ToString() != "Create" ? "active" : "")">
                            Reservas
                        </a>
                    </li>
                </ul>

            </div>
        </nav>
    </header>

    <!-- ── Main content ───────────────────────────────────── -->
    <main class="site-main" role="main" id="content">

        @* TempData success message (PRG pattern) *@
        @if (TempData["Exito"] is string msg)
        {
            <div class="alert-lux alert-lux--success" role="alert" id="alertSuccess">
                <svg width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true">
                    <circle cx="7.5" cy="7.5" r="6.5" stroke="currentColor"/>
                    <path d="M4.5 7.5l2 2 4-4" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                @msg
                <button class="alert-close" onclick="this.parentElement.remove()" aria-label="Cerrar">&#215;</button>
            </div>
        }

        @RenderBody()

    </main>

    <!-- ── Footer ─────────────────────────────────────────── -->
    <footer class="site-footer" role="contentinfo">
        <p class="site-footer__brand">Hotel Aurora</p>
        <p class="site-footer__copy">&copy; @DateTime.Now.Year &mdash; Sistema de Gestión Hotelera &middot; Todos los derechos reservados</p>
    </footer>

    <script>
        // Mobile nav toggle
        (function () {
            var toggle = document.getElementById('navToggle');
            var links  = document.getElementById('navLinks');
            if (!toggle || !links) return;
            toggle.addEventListener('click', function () {
                var open = links.classList.toggle('open');
                toggle.setAttribute('aria-expanded', open);
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
